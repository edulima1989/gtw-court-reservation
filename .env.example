# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword

# Authentication microservice
JWT_SECRET=replace-this-64-byte-minimum-jwt-secret-before-production-use-2026-auth
JWT_EXPIRATION=86400000

# Public origin of each remote microfrontend (applied at build time)
RESERVAS_ASSET_PREFIX=http://localhost:3001
ADMIN_ASSET_PREFIX=http://localhost:3002
REPORTES_ASSET_PREFIX=http://localhost:3003
