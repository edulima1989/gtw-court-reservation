    {
      "name": "01 - Autenticación y Usuarios (msa-court-reservation-authentication)",
      "description": "Endpoints para registro, login con credenciales predeterminadas (ADMIN y USUARIO_FINAL), validación de token y administración de usuarios.",
      "item": [
        {
          "name": "Iniciar Sesión - ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.collectionVariables.set('auth_token', res.token);",
                  "        pm.collectionVariables.set('admin_token', res.token);",
                  "    }",
                  "    if (res.userId) {",
                  "        pm.collectionVariables.set('adminUserId', res.userId.toString());",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userMail\": \"{{admin_email}}\",\n  \"userPassword\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "users",
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Iniciar Sesión - USUARIO_FINAL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
