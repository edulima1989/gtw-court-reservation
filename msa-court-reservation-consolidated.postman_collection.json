                  "        pm.collectionVariables.set('auth_token', res.token);",
                  "        pm.collectionVariables.set('user_token', res.token);",
                  "    }",
                  "    if (res.userId) {",
                  "        pm.collectionVariables.set('userId', res.userId.toString());",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
